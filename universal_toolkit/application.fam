App(
    appid="universal_toolkit",
    name="Universal Toolkit",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="toolkit_app",
    requires=["gui"],
    # 16 KB: Phase 1 compiles the three existing apps in as modules (NFC +
    # EMV parsing, HF/LF RFID, SubGHz capture/replay) -- the heaviest,
    # subghz_auto_recorder, alone used ~12 KB standalone. Re-measure
    # `Stack Min` after build (CLAUDE.md ritual) and raise here -- in this
    # commit, not later -- if any module is not comfortably above the
    # 4096-byte floor (see Phase 1 verification in CLAUDE.md).
    stack_size=16 * 1024,
    fap_category="Tools",
    fap_description="Launcher shell for the Flipper Zero tool modules in this repo.",
    fap_author="farhadsoft",
    fap_version="0.2",
    fap_icon="icon.png",
    sources=[
        "toolkit.c",
        "toolkit_log.c",
        "toolkit_ui.c",
        "modules/**/*.c",
        "universal_card_reader/*.c",
        "subghz_auto_recorder/*.c",
        "rfid_multi_reader/*.c",
    ],
)
